{
  "tasks": {
    "prebuild:utils": {
      "outputs": ["dist/**"]
    },
    "prebuild": {
      "dependsOn": ["prebuild:utils"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["prebuild"],
      "outputs": ["dist/**"]
    },
    "start": {
      "cache": false,
      "dependsOn": ["dev"],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "react:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "test": {},
    "test:ci": {}
  }
}
