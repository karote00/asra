{
  "name": "@asyra/core",
  "version": "0.5.3",
  "description": "Public composition core for canvas-based, visual, and domain-driven Asyra products",
  "author": "Asa Tsai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karote00/asyra.git",
    "directory": "packages/core"
  },
  "homepage": "https://asyra-framework.vercel.app",
  "keywords": [
    "application-framework",
    "canvas-framework",
    "canvas-editor",
    "visual-editor",
    "whiteboard",
    "bim",
    "undo-redo",
    "information-modeling",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./canvas-pipeline-debugger": {
      "types": "./dist/canvas-pipeline-debugger/index.d.ts",
      "import": "./dist/canvas-pipeline-debugger/index.js",
      "default": "./dist/canvas-pipeline-debugger/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build:core": "tsc",
    "clean": "rm -rf dist",
    "has:test": "find . -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" \\) | grep -q .",
    "test": "yarn has:test && vitest || echo 'No test files found. Skipping test.'",
    "test:local": "vitest run",
    "test:ci": "yarn has:test && vitest run --coverage --reporter=default --reporter=junit || echo 'No test files found. Skipping test:ci.'"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@asyra/factory": "workspace:*",
    "@asyra/feature-system": "workspace:*",
    "@asyra/input-system": "workspace:*",
    "@asyra/persistence": "workspace:*",
    "@asyra/props-manager": "workspace:*",
    "@asyra/reactive-events": "workspace:*",
    "@asyra/render": "workspace:*",
    "@asyra/render-engine": "workspace:*",
    "@asyra/scene-tree": "workspace:*",
    "@asyra/selection": "workspace:*",
    "@asyra/system-context": "workspace:*",
    "@asyra/ui-context": "workspace:*",
    "@asyra/utils": "workspace:*",
    "rxjs": "^7.8.1"
  }
}
