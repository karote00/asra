{
  "name": "@asyra/reactive-events",
  "version": "0.2.5",
  "description": "Event middleware",
  "author": "Asa Tsai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.3.1",
  "keywords": [],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build:reactive-events": "tsc",
    "clean": "rm -rf dist",
    "has:test": "find . -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" \\) | grep -q .",
    "test": "yarn has:test && vitest || echo 'No test files found. Skipping test.'",
    "test:local": "vitest run",
    "test:ci": "yarn has:test && vitest run --coverage --reporter=default --reporter=junit || echo 'No test files found. Skipping test:ci.'",
    "add-event": "tsx scripts/add-event.ts"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.6",
    "@types/node": "^25.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "inquirer": "^8.0.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@asyra/persistence": "workspace:*",
    "@asyra/utils": "workspace:*",
    "rxjs": "^7.8.1"
  }
}
