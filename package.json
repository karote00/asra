{
  "name": "asyra",
  "version": "0.2.0",
  "description": "An open-source design tool demonstrating Communication-Driven Development and AI collaboration patterns.",
  "author": "Asa Tsai",
  "license": "MIT",
  "packageManager": "yarn@4.3.1",
  "main": "index.js",
  "type": "module",
  "keywords": [
    "design-tool",
    "communication-driven-development",
    "cdd",
    "event-driven-architecture",
    "ai-collaboration",
    "typescript",
    "react",
    "monorepo",
    "reference-implementation"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.js",
    "watch:design-system": "turbo run watch:design-system",
    "rebuild:design-system": "yarn workspace @asyra/design-system rebuild:design-system",
    "react:build": "turbo run react:build",
    "test": "turbo run test",
    "test:local": "turbo run test:local",
    "test:ci": "turbo run test:ci",
    "test:e2e": "yarn workspace @asyra/asyra-design test:e2e",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "clean": "turbo run clean",
    "reinstall": "yarn clean && rm -rf node_modules .turbo && yarn && yarn react:build",
    "gen:turbo": "node scripts/gen-turbo.js && yarn install",
    "gen:event": "yarn workspace @asyra/reactive-events add-event",
    "gen:interaction": "yarn workspace @asyra/reactive-events add-interaction",
    "predev": "yarn gen:turbo",
    "deps:validate": "node scripts/deps-validate.js",
    "deps:validate:verbose": "node scripts/deps-validate.js --verbose",
    "bump:workspace": "node scripts/bump-workspace-versions.js",
    "release:app": "node scripts/release-template.js",
    "release:app:verbose": "node scripts/release-template.js --verbose",
    "release:full": "node scripts/release-full.js",
    "release:full:asyra-design": "node scripts/release-full.js --prod=asyra-design"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "20.x",
    "yarn": ">=4.3.1"
  },
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.18.2",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "context-rag": "^2.1.4",
    "handoff-ai": "^0.7.0"
  }
}
