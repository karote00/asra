{
  "name": "asra",
  "version": "1.0.1",
  "description": "An open-source prototype tool names Asra.",
  "author": "Asa Tsai",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.3.1",
  "main": "index.js",
  "keywords": [],
  "scripts": {
    "start": "turbo run start",
    "react:build": "turbo run react:build",
    "build": "turbo run build",
    "test": "turbo run test"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces",
    "preferInteractive": true
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
