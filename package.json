{
  "name": "asyra",
  "version": "0.2.5",
  "description": "An open-source design tool demonstrating Communication-Driven Development and AI collaboration patterns.",
  "author": "Asa Tsai",
  "license": "MIT",
  "packageManager": "yarn@4.3.1",
  "main": "index.js",
  "type": "module",
  "keywords": [
    "design-tool",
    "communication-driven-development",
    "cdd",
    "event-driven-architecture",
    "ai-collaboration",
    "typescript",
    "react",
    "monorepo",
    "reference-implementation"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.js",
    "watch:design-system": "turbo run watch:design-system",
    "rebuild:design-system": "yarn workspace @asyra/design-system rebuild:design-system",
    "react:build": "yarn gen:turbo:check && turbo run react:build",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/__tests__/deps-validate.test.mjs scripts/__tests__/workspace-automation.test.mjs scripts/__tests__/release-automation.test.mjs scripts/__tests__/release-records.test.mjs scripts/__tests__/changeset-all-patch.test.mjs scripts/__tests__/changeset-closeout.test.mjs scripts/__tests__/test-file-placement.test.mjs scripts/__tests__/brand-neutral-code.test.mjs",
    "test:local": "yarn test:scripts && turbo run test:local",
    "test:ci": "yarn test:scripts && turbo run test:ci",
    "test:e2e": "yarn workspace @asyra/asyra-design test:e2e",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "clean": "turbo run clean",
    "reinstall": "yarn clean && rm -rf node_modules .turbo && yarn && yarn react:build",
    "gen:turbo": "node scripts/gen-turbo.js --write",
    "gen:turbo:check": "node scripts/gen-turbo.js --check",
    "gen:event": "yarn workspace @asyra/reactive-events add-event",
    "changeset:check": "node scripts/validate-pr-changeset.mjs",
    "deps:validate": "node --test scripts/__tests__/deps-validate.test.mjs && node scripts/deps-validate.js",
    "deps:validate:verbose": "node --test scripts/__tests__/deps-validate.test.mjs && node scripts/deps-validate.js --verbose",
    "bump:workspace": "node scripts/bump-workspace-versions.js",
    "release:app": "node scripts/release-template.js",
    "release:app:build": "node scripts/build-release-template.js",
    "release:app:verbose": "node scripts/release-template.js --verbose",
    "release:app:check": "node scripts/release-template.js --check",
    "release:validate": "node scripts/release-validate.js",
    "release:packages": "node scripts/release-package-artifacts.js",
    "release:consumer": "node scripts/release-readiness.js",
    "release:template": "node scripts/release-template-readiness.js",
    "release:records": "node --test scripts/__tests__/release-records.test.mjs && node scripts/release-records.js",
    "release:full": "node scripts/release-full.js",
    "release:full:asyra-design": "node scripts/release-full.js --prod=asyra-design",
    "dev:description": "Run in watch mode: all packages including design-system, asyra-design app"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "create-app/*"
  ],
  "engines": {
    "node": "24.x",
    "yarn": ">=4.3.1"
  },
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.0",
    "jsdom": "16.7.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "context-rag": "^2.1.4",
    "handoff-ai": "^0.7.0"
  }
}
