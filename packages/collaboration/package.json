{
  "name": "@asyra/collaboration",
  "version": "0.5.1",
  "description": "Optional provider-replaceable publication transport for Asyra",
  "author": "Asa Tsai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.3.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "build:collaboration": "tsc",
    "example:collaboration": "vitest run src/__tests__/documentation-example.test.js",
    "test": "vitest",
    "test:local": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@asyra/factory": "workspace:*",
    "@asyra/utils": "workspace:*"
  }
}
