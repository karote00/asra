{
  "globalEnv": [
    "ASYRA_DESIGN_APP_URL",
    "ASYRA_DESIGN_COLLABORATION_WS_HOST",
    "ASYRA_DESIGN_COLLABORATION_WS_PORT",
    "VITE_ASYRA_DESIGN_COLLABORATION_WS_URL"
  ],
  "tasks": {
    "watch:design-system": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "^dev"
      ],
      "outputs": [
        "dist/**"
      ],
      "persistent": true
    },
    "react:start": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {},
    "test:local": {},
    "test:ci": {},
    "@asyra/asyra-design#react:build": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/collaboration#build:collaboration",
        "@asyra/core#build:core",
        "@asyra/design-system#build:design-system",
        "@asyra/factory#build:factory",
        "@asyra/feature-system#build:feature-system",
        "@asyra/input-system#build:input-system",
        "@asyra/preset#build:preset",
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/render#build:render",
        "@asyra/ui-context#build:ui-context",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/collaboration#build:collaboration": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/factory#build:factory"
      ]
    },
    "@asyra/core#build:core": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/factory#build:factory",
        "@asyra/feature-system#build:feature-system",
        "@asyra/input-system#build:input-system",
        "@asyra/persistence#build:persistence",
        "@asyra/props-manager#build:props-manager",
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/render#build:render",
        "@asyra/render-engine#build:render-engine",
        "@asyra/scene-tree#build:scene-tree",
        "@asyra/selection#build:selection",
        "@asyra/system-context#build:system-context",
        "@asyra/ui-context#build:ui-context",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/design-system#build:design-system": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/factory#build:factory": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/feature-system#build:feature-system": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/input-system#build:input-system": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/persistence#build:persistence": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/preset#build:preset": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/core#build:core",
        "@asyra/render-engine#build:render-engine",
        "@asyra/render-engine-pixi#build:render-engine-pixi",
        "@asyra/ui-context#build:ui-context",
        "@asyra/utils#build:utils",
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/render#build:render"
      ]
    },
    "@asyra/props-manager#build:props-manager": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/reactive-events#build:reactive-events": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/persistence#build:persistence",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/render#build:render": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/factory#build:factory",
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/render-engine#build:render-engine",
        "@asyra/scene-tree#build:scene-tree",
        "@asyra/selection#build:selection",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/render-engine#build:render-engine": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": []
    },
    "@asyra/render-engine-pixi#build:render-engine-pixi": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/render-engine#build:render-engine"
      ]
    },
    "@asyra/scene-tree#build:scene-tree": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/props-manager#build:props-manager",
        "@asyra/reactive-events#build:reactive-events",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/selection#build:selection": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/system-context#build:system-context": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/ui-context#build:ui-context": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "@asyra/scene-tree#build:scene-tree",
        "@asyra/selection#build:selection",
        "@asyra/utils#build:utils"
      ]
    },
    "@asyra/utils#build:utils": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": []
    }
  }
}
