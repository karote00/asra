{
  "name": "@asyra/design-system",
  "version": "0.5.2",
  "description": "Official React component library for Asyra applications",
  "author": "Asa Tsai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karote00/asyra.git",
    "directory": "packages/design-system"
  },
  "homepage": "https://asyra-framework.vercel.app",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.3.1",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./index.css": "./dist/design-system.css"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:design-system": "vite build && tsc",
    "rebuild:design-system": "yarn prebuild:design-system && yarn build:design-system",
    "dev": "concurrently \"tsc --watch --preserveWatchOutput\" \"vite build --watch\"",
    "watch:design-system": "vite build --watch",
    "prebuild:design-system": "tailwindcss -i ./src/index.css -o ./dist/index.css",
    "preview": "vite preview",
    "test:local": "vitest run --environment jsdom --no-file-parallelism",
    "test:ci": "vitest run --environment jsdom --no-file-parallelism --coverage --reporter=default --reporter=junit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.3",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-onboarding": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "8.6.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@asyra/utils": "workspace:*"
  }
}
