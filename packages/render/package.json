{
  "name": "@asyra/render",
  "version": "0.2.5",
  "description": "Render engine",
  "author": "Asa Tsai",
  "license": "MIT",
  "packageManager": "yarn@4.3.1",
  "keywords": [],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build:render": "tsc",
    "clean": "rm -rf dist",
    "has:test": "find . -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" \\) | grep -q .",
    "test": "yarn has:test && vitest || echo 'No test files found. Skipping test.'",
    "test:local": "vitest run",
    "test:ci": "yarn has:test && vitest run --coverage --reporter=default --reporter=junit || echo 'No test files found. Skipping test:ci.'"
  },
  "dependencies": {
    "@asyra/factory": "workspace:*",
    "@asyra/reactive-events": "workspace:*",
    "@asyra/render-engine": "workspace:*",
    "@asyra/scene-tree": "workspace:*",
    "@asyra/selection": "workspace:*",
    "@asyra/system-context": "workspace:*",
    "@asyra/utils": "workspace:*",
    "earcut": "^2.2.4",
    "pixi.js": "^8.6.3"
  },
  "devDependencies": {
    "@types/earcut": "^2.1.4",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
