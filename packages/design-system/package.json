{
  "name": "@asra/design-system",
  "version": "1.0.1",
  "packageManager": "yarn@4.3.1",
  "type": "module",
  "main": "./dist/design-system.umd.js",
  "module": "./dist/design-system.es.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": "./dist/design-system.es.js",
    "./dist/*": "./dist/*",
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:module-base": "vite build && tsc && yarn prebuild:design-system",
    "build:watch-css": "yarn prebuild:design-system --watch",
    "dev": "concurrently 'tsc --watch' 'vite build --watch' 'yarn build:watch-css'",
    "prebuild:design-system": "tailwindcss -i ./src/index.css -o ./dist/index.css",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@asra/utils": "workspace:*",
    "@chromatic-com/storybook": "^3.2.3",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/react-vite": "8.4.7",
    "@storybook/test": "8.4.7",
    "@storybook/types": "^8.4.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^4.3.0"
  }
}
