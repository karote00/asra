{
  "tasks": {
    "watch:design-system": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "^dev"
      ],
      "outputs": [
        "dist/**"
      ],
      "persistent": true
    },
    "react:start": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {},
    "test:local": {},
    "test:ci": {},
    "react:build": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:core",
        "^build:design-system",
        "^build:feature-system",
        "^build:preset",
        "^build:reactive-events",
        "^build:ui-context",
        "^build:utils"
      ]
    },
    "build:core": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:factory",
        "^build:feature-system",
        "^build:input-system",
        "^build:persistence",
        "^build:props-manager",
        "^build:reactive-events",
        "^build:render",
        "^build:scene-tree",
        "^build:selection",
        "^build:system-context",
        "^build:ui-context",
        "^build:utils"
      ]
    },
    "build:design-system": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:utils"
      ]
    },
    "build:factory": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:feature-system": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:input-system": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:persistence": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:utils"
      ]
    },
    "build:preset": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:core",
        "^build:props-manager",
        "^build:render",
        "^build:scene-tree",
        "^build:system-context",
        "^build:utils"
      ]
    },
    "build:props-manager": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:reactive-events": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:persistence",
        "^build:utils"
      ]
    },
    "build:render": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:factory",
        "^build:reactive-events",
        "^build:render-engine",
        "^build:scene-tree",
        "^build:selection",
        "^build:system-context",
        "^build:utils"
      ]
    },
    "build:render-engine": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": []
    },
    "build:render-engine-pixi": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:render-engine"
      ]
    },
