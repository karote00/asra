{
  "tasks": {
    "watch:design-system": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "outputs": ["dist/**"],
      "persistent": true
    },
    "react:start": {
      "cache": false,
      "outputs": ["dist/**"],
      "persistent": true
    },
    "build:base": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "build:module-base": {
      "cache": false,
      "dependsOn": ["^build:base"],
      "outputs": ["dist/**"]
    },
    "build:module": {
      "cache": false,
      "dependsOn": ["^build:module-base", "^build:base"],
      "outputs": ["dist/**"]
    },
    "build:core": {
      "cache": false,
      "dependsOn": ["^build:module", "^build:module-base", "^build:base"],
      "outputs": ["dist/**"]
    },
    "react:build": {
      "cache": false,
      "dependsOn": ["^build:core", "^build:module-base", "^build:base"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "test": {},
    "test:ci": {}
  }
}
