{
  "name": "@asyra/design-system",
  "version": "0.2.5",
  "packageManager": "yarn@4.3.1",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./index.css": "./dist/design-system.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:design-system": "vite build && tsc",
    "rebuild:design-system": "yarn prebuild:design-system && yarn build:design-system",
    "dev": "concurrently \"tsc --watch --preserveWatchOutput\" \"vite build --watch\"",
    "watch:design-system": "vite build --watch",
    "prebuild:design-system": "tailwindcss -i ./src/index.css -o ./dist/index.css",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.3",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/react-vite": "^8.6.9",
    "@storybook/test": "8.4.7",
    "@storybook/types": "^8.4.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.2.3",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-svgr": "^4.3.0"
  },
  "dependencies": {
    "@asyra/utils": "workspace:*"
  }
}
