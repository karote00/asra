{
  "globalEnv": [
    "ASYRA_DESIGN_APP_URL",
    "ASYRA_DESIGN_COLLABORATION_WS_HOST",
    "ASYRA_DESIGN_COLLABORATION_WS_PORT",
    "VITE_ASYRA_DESIGN_COLLABORATION_WS_URL"
  ],
  "tasks": {
    "watch:design-system": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "^dev"
      ],
      "outputs": [
        "dist/**"
      ],
      "persistent": true
    },
    "react:start": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "test": {},
    "test:local": {},
    "test:ci": {}
  }
}
