{
  "name": "@asyra/selection",
  "version": "0.5.2",
  "description": "A selection management library for handling element, vertex, edge, or any other selectable entities in a scene graph.",
  "author": "Asa Tsai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karote00/asyra.git",
    "directory": "packages/selection"
  },
  "homepage": "https://asyra-framework.vercel.app",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.3.1",
  "keywords": [],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build:selection": "tsc",
    "clean": "rm -rf dist",
    "has:test": "find . -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" \\) | grep -q .",
    "test": "yarn has:test && vitest || echo 'No test files found. Skipping test.'",
    "test:local": "vitest run",
    "test:ci": "yarn has:test && vitest run --coverage --reporter=default --reporter=junit || echo 'No test files found. Skipping test:ci.'"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@asyra/utils": "workspace:*"
  }
}
