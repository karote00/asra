{
  "name": "@asra/core",
  "version": "1.0.1",
  "description": "Core of Asra.",
  "author": "Asa Tsai",
  "license": "MIT",
  "packageManager": "yarn@4.3.1",
  "keywords": [],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build:core": "tsc",
    "clean": "rm -rf dist",
    "has:test": "find . -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" \\) | grep -q .",
    "test": "yarn has:test && vitest || echo 'No test files found. Skipping test.'",
    "test:local": "yarn has:test && vitest run || echo 'No test files found. Skipping test:local.'",
    "test:ci": "yarn has:test && vitest run --coverage --reporter=default --reporter=junit || echo 'No test files found. Skipping test:ci.'"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@asra/factory": "workspace:*",
    "@asra/input-system": "workspace:*",
    "@asra/interaction-core": "workspace:*",
    "@asra/props-manager": "workspace:*",
    "@asra/reactive-events": "workspace:*",
    "@asra/render": "workspace:*",
    "@asra/scene-tree": "workspace:*",
    "@asra/selection": "workspace:*",
    "@asra/system-context": "workspace:*",
    "@asra/utils": "workspace:*"
  }
}