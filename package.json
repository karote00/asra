{
  "name": "asra",
  "version": "1.0.1",
  "description": "An open-source prototype tool names Asra.",
  "author": "Asa Tsai",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.3.1",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "scripts": {
    "react:start": "turbo run react:start",
    "react:build": "turbo run react:build",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "clean": "turbo run clean",
    "vercel-build": "turbo run react:build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces",
    "preferInteractive": true
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.18.2"
  }
}
