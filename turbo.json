      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:props-manager",
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:selection": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:system-context": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:reactive-events",
        "^build:utils"
      ]
    },
    "build:ui-context": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build:factory",
        "^build:reactive-events",
        "^build:scene-tree",
        "^build:selection",
        "^build:utils"
      ]
    },
    "build:utils": {
      "cache": false,
      "outputs": [
        "dist/**"
      ],
      "dependsOn": []
    }
  }
}
