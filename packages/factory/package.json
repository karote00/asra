{
  "name": "@asyra/factory",
  "version": "0.2.5",
  "description": "Manipulate with data changes",
  "author": "Asa Tsai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "yarn@4.3.1",
  "keywords": [],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build:factory": "tsc",
    "clean": "rm -rf dist",
    "has:test": "find . -type f \\( -name \"*.test.ts\" -o -name \"*.test.tsx\" \\) | grep -q .",
    "test": "yarn has:test && vitest || echo 'No test files found. Skipping test.'",
    "test:local": "vitest run",
    "test:ci": "yarn has:test && vitest run --coverage --reporter=default --reporter=junit || echo 'No test files found. Skipping test:ci.'"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@asyra/reactive-events": "workspace:*",
    "@asyra/utils": "workspace:*"
  }
}
