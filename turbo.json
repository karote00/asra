{
  "tasks": {
    "watch:design-system": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"],
      "outputs": ["dist/**"],
      "persistent": true
    },
    "react:start": {
      "cache": false,
      "outputs": ["dist/**"],
      "persistent": true
    },
    "build:base": {
      "cache": false,
      "outputs": ["dist/**"]
    },
    "build:module-base": {
      "cache": false,
      "dependsOn": ["^build:base"],
      "outputs": ["dist/**"]
    },
    "build:module": {
      "cache": false,
      "dependsOn": ["^build:module-base"],
      "outputs": ["dist/**"]
    },
    "build:intermediate-core": {
      "cache": false,
      "dependsOn": ["^build:module-base", "^build:module"],
      "outputs": ["dist/**"]
    },
    "build:core-base": {
      "cache": false,
      "dependsOn": ["^build:intermediate-core"],
      "outputs": ["dist/**"]
    },
    "build:core": {
      "cache": false,
      "dependsOn": [
        "^build:core-base",
        "^build:module",
        "^build:module-base",
        "^build:intermediate-core"
      ],
      "outputs": ["dist/**"]
    },
    "react:build": {
      "cache": false,
      "dependsOn": ["^build:core", "^build:core-base", "^build:module-base"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "test": {},
    "test:ci": {}
  }
}
